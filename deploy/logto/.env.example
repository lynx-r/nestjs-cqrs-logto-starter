DB_URL=postgres://logto:<logto-password>@database-local:5432/logto

# Redis
REDIS_URL=redis://:<redis password>@redis:6379/1

# для init-db.sh
LOGTO_DB=logto
LOGTO_USER=logto
LOGTO_PASSWORD=l0gt0

# DB
DB_HOST=database-dev
DB_USER=logto
DB_PASSWORD=<logto-password>
DB_DATABASE=logto

# Экспортер prometheuscommunity/postgres-logto для logto
DATA_SOURCE_NAME=postgresql://logto:<logto db password>@database:5432/logto?sslmode=disable

ENDPOINT=http://auth.localhost.test
ADMIN_ENDPOINT=http://auth-admin.localhost.test

SECRET_VAULT_KEK=<openssl rand -base64 33>

TRUST_PROXY_HEADER=1

HTTPS_CERT_PATH=/etc/logto/ssl/localhost.test.pem
HTTPS_KEY_PATH=/etc/logto/ssl/localhost.test-key.pem
