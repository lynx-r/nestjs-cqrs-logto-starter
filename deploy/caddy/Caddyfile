# Глобальные настройки: включаем сбор метрик во всем Caddy
{
    admin 0.0.0.0:2019

    servers {
        metrics
    }
}

# Основной домен, витрина магазина: storefront
vnutri-d3.shop {
    @malicious_scanners {
        path /wp-admin* /wp-login* /wordpress* /.env* *.php /.git*
    }

    # 1. Сначала проверяем на ботов/сканеры
    handle @malicious_scanners {
        respond "Not Found" 404 {
            close
        }
    }

    # Nuxt Frontend (все остальные запросы)
    handle {
        reverse_proxy storefront:3000
    }
}

# Directus CMS
cms.vnutri-d3.shop {
    reverse_proxy directus:8055
}

# Vendure shop
shop.vnutri-d3.shop {
    reverse_proxy vendure:3000
}

# Logto API & UI
auth.vnutri-d3.shop {
    reverse_proxy logto:3001
}

# Logto Admin Console
auth-admin.vnutri-d3.shop {
    reverse_proxy logto:3002
}

# Mail server
mail.vnutri-d3.shop {
    redir https://webmail.hosting.reg.ru{uri}
}

# Grafana
monitoring.vnutri-d3.shop {
    reverse_proxy grafana:3000
}
